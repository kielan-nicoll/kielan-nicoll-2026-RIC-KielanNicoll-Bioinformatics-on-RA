# Making an general gene extraction function.

extract_genes_from_pathway <- function(gse_obj, pathway_name) {
  genes <- strsplit(
    gse_obj@result$core_enrichment[gse_obj@result$Description == pathway_name],
    "/"
  )[[1]]
  return(genes)}

