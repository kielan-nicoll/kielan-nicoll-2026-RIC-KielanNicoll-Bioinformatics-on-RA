# RAest-DGEA --------------------------------------------------------------


# Now contrasting with RAest vs normal in females

res_RAest_F <- results(dds, name = "disease_RA_est_vs_Normal")

# then checking RAest vs normal in males for interactions

res_RAest_Mint <- results(dds, name = "diseaseRA_est.SexM")

res_RAest_M <- results(dds,
                       contrast = list(c("disease_RA_est_vs_Normal",
                                         "diseaseRA_est.SexM")))

# Now filtering results

sig_RAest_F <- res_RAest_F[
  !is.na(res_RAest_F$padj) &
    res_RAest_F$padj < 0.05 &
    abs(res_RAest_F$log2FoldChange) > 0.5,]

sig_RAest_M <- res_RAest_M[
  !is.na(res_RAest_M$padj) &
    res_RAest_M$padj < 0.05 &
    abs(res_RAest_M$log2FoldChange) > 0.5,]

sig_RAest_Mint <- res_RAest_Mint[
  !is.na(res_RAest_Mint$padj) &
    res_RAest_Mint$padj < 0.05 &
    abs(res_RAest_Mint$log2FoldChange) > 0.5,]

# Overlap analysis of RAest genes

RAest_common_genes <- intersect(rownames(sig_RAest_F), rownames(sig_RAest_M))
RAest_female_only <- setdiff(rownames(sig_RAest_F), rownames(sig_RAest_M))
RAest_male_only <- setdiff(rownames(sig_RAest_M), rownames(sig_RAest_F))

# now compiling results for GSEA later.

genelist_RAest_F <- res_RAest_F$log2FoldChange
names(genelist_RAest_F) <- rownames(res_RAest_F)
genelist_RAest_F <- sort(genelist_RAest_F, decreasing = TRUE)

genelist_RAest_M <- res_RAest_M$log2FoldChange
names(genelist_RAest_M) <- rownames(res_RAest_M)
genelist_RAest_M <- sort(genelist_RAest_M, decreasing = TRUE)

genelist_RAest_Mint <- res_RAest_Mint$log2FoldChange
names(genelist_RAest_Mint) <- rownames(res_RAest_Mint)
genelist_RAest_Mint <- sort(genelist_RAest_Mint, decreasing = TRUE)

