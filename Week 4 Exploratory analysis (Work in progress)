boxplot(assay(dds),
        outline = FALSE,
        las = 1,
        main = "dds raw counts per sample", 
        ylab = "Raw RNA-seq counts", 
        xlab = "Sample ID")

# high dispersion, with somewhat normalized means.

# applying DESeq2 analysis
dds <- DESeq(dds)

# Seeing if dispersion fits visually 
plotDispEsts((dds), 
             main = "Dispersion Estimate for dds")
# fitted line decently fits final dispersion, meaning a negative binomial 
