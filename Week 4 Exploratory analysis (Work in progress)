# Loading a raw count matrix downloaded from GEO supplementary files
# File: GSE89408_raw_counts_GRCh38.p13_NCBI.tsv
# Source: NCBI GEO (Series GSE89408) supplementary data
# Description:
#   - Rows = genes (Entrez Gene IDs)
#   - Columns = RNA-seq samples
#   - Values = raw read counts mapped to genes
#   - Reference genome: GRCh38.p13

# Expression data retrieved from getGEO() was already normalized, which
# would mean it is not raw counts which are required for Deseq2 analysis.
# This file contains the original raw RNA-seq read counts which are required
# for the DGEA that I plan on doing.

counts <- read.table("GSE89408_raw_counts_GRCh38.p13_NCBI.tsv",
                     header = TRUE,
                     sep = "\t",
                     row.names = 1,
                     check.names = FALSE)

# checking counts data
head(counts[,1])
# [1]   61 1699  119    3    0    3

# Verifying that the data represents raw counts rather than normalized data.
# Raw RNA-seq counts should be integer values.
all(counts %% 1 == 0)
# [1] TRUE -> this indicates that counts are integer values, 

# Additionally, the count range includes large values typical of raw read counts
range(counts)
# [1]   0   19317662

# Since all values are integers and span a wide range of sequencing depths,
# this confirms that the file contains raw read counts suitable for DESeq2.

# Because of how DESeq2 works, the raw counts will be normalized internally 
# using size factor estimation and variance stabilizing transformation (VST)
# This avouds using externally normalized data which ensures that dispersion
# estimates and differential expression statistics are calculated correctly
# according to the DESeq2 workflow.


# checking to see if data is aligned

# pheno and counts differ in length, meaning one is either missing, or has too
# many, so using intersect I grab only common samples between the two.

# Find common samples
common_samples <- intersect(rownames(pheno), colnames(counts))
length(common_samples)

# Subset and reorder
pheno <- pheno[common_samples, , drop=FALSE]
counts <- counts[, common_samples, drop=FALSE]

all(rownames(pheno) == colnames(counts))
# [1] TRUE

#
#
#
# data is properly aligned, now I can do a pre-analysis.
# By ensuring that sample identifiers match between phenotype metadata
# and the RNA-seq count matrix I am able to match metadata characteristics
# like sex and disease type to the RNA-seq raw counts. This allows for 
# pathway comparisons between such characteristics. Intersect() is used
# to identify samples that appear in  both data sets so that phenotype
# metadata and count data remain correctly aligned. 
#
#
#
# Sex will not be used to subset the data set into separate analyses, instead
# it will be included as a co-variate in the DESeq2 design formula so that 
# differential expression results account for the transcriptional differences 
# between males and females.
#
#
#


